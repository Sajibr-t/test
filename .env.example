# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# Database connection.
# Development uses a local SQLite file; for production switch the datasource in
# prisma/schema.prisma to "postgresql" and put your connection string here.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (JWT).
# Use a long random string — anyone who knows this value could forge an admin
# session. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"
