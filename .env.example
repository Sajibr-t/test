# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# Database connection.
# SQLite requires persistent disk storage in production. A PostgreSQL switch
# requires a separate migration baseline and data transfer; see DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (JWT).
# Use a long random string — anyone who knows this value could forge an admin
# session. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public HTTPS origin used in account emails and SEO. No trailing path.
SITE_URL=""
# Transactional email provider: verified sender and server-side key.
RESEND_API_KEY=""
EMAIL_FROM=""
# Separate random secret (32+ characters) for POST /api/jobs/email.
JOBS_SECRET=""
